# Arnobot PMS admin panel. Copy to .env. Only NEXT_PUBLIC_* values reach the browser: never put secrets there.
# Where Next.js proxies /api/v1/* (server side only).
API_INTERNAL_URL=http://localhost:4000
# Socket.IO endpoint the browser connects to for live push (browser-safe, no secret).
NEXT_PUBLIC_WS_URL=http://localhost:4000
