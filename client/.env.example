# Arnobot client portal (customer organizations). Copy to .env. Only NEXT_PUBLIC_* values reach the browser.
# Where Next.js proxies /api/v1/* (server side only). Same backend as the admin panel.
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
# The admin panel, linked from the staff-preview banner.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
