# ─────────────────────────────────────────────────────────────────────────────
# Arnobot PMS — environment. Copy to .env and fill in. NEVER commit .env.
# Server-only variables must NEVER be prefixed with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database: local PostgreSQL (16+). TimescaleDB is optional (see docs/database.md)
# Superuser connection, used ONLY by "npm run db:create" to create the role + database.
PG_ADMIN_URL=postgres://postgres:<postgres-password>@localhost:5432/postgres
DATABASE_URL=postgres://pms:change-me@localhost:5432/arnobot_pms

# ── File storage (spec §8: files never in the DB) ───────────────────────────
# local = versioned files on disk under STORAGE_LOCAL_DIR (dev); s3 = S3/MinIO (prod)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Used when STORAGE_DRIVER=s3 (enable bucket versioning on the bucket!)
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=arnobot-pms
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# ── Secrets (server only) ───────────────────────────────────────────────────
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=1
# Previous keys, kept only to decrypt rows written before a key rotation: "1:<base64>,2:<base64>"
CREDENTIAL_ENCRYPTION_OLD_KEYS=
# HMAC pepper for session tokens and signed download links.
SESSION_SECRET=
SESSION_TTL_HOURS=12

# ── First super-admin created by "npm run db:seed" ───────────────────────────────────────
SEED_ADMIN_EMAIL=team@arnobot.in
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Arnobot Admin
# Also create demo robots (saibya01, saibya02, altius01) + write .sim-keys.json
SEED_DEMO_ROBOTS=true

# ── Services ────────────────────────────────────────────────────────────────
# One backend serves the admin API and robot/GCS ingestion (POST /api/v1/ingest).
API_PORT=4000
# 127.0.0.1 = this machine only. Use 0.0.0.0 when a GCS on the LAN / tunnel must reach ingestion.
API_HOST=127.0.0.1
# Ingestion limits (a reconnecting robot uploads backlog in batches).
INGEST_BODY_LIMIT_MB=20
INGEST_RATE_LIMIT_PER_MIN=600
ADMIN_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Cookie Secure flag. MUST be true in production (HTTPS).
COOKIE_SECURE=false
# Max upload size for documents / release packages (MB)
MAX_UPLOAD_MB=1024

# ── Optional MQTT transport for ingestion (empty = HTTPS only) ─────────────────
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Admin panel ─────────────────────────────────────────────────────────────
# Where Next.js proxies /api/v1/* (server side only).
API_INTERNAL_URL=http://localhost:4000
# Socket.IO endpoint the browser connects to for live push (browser-safe, no secret).
NEXT_PUBLIC_WS_URL=http://localhost:4000
