# ─────────────────────────────────────────────────────────────────────────────
# Arnobot PMS backend — environment (the admin panel has its own frontend/.env). Copy to .env and fill in. NEVER commit .env.
# Server-only variables must NEVER be prefixed with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database: a separate service (local PostgreSQL or AWS RDS). The server only CONNECTS:
# the schema is created and migrated from storage/ (npm run db:migrate there).
DATABASE_URL=postgres://pms:change-me@localhost:5432/arnobot_pms

# ── File storage (spec §8: files never in the DB) ───────────────────────────
# local = versioned files on disk under STORAGE_LOCAL_DIR (dev); s3 = S3/MinIO (prod)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Used when STORAGE_DRIVER=s3 (enable bucket versioning on the bucket!)
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=arnobot-pms
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# ── Video / sensor archive (camera recordings from cloud_sync) ─────────────
# Videos are stored ONLY in this S3 bucket (separate from the documents storage above): the server keeps
# no copy. Uploads stream straight into the bucket; playback and downloads stream straight out of it.
# For development without AWS, any S3-compatible store works (e.g. MinIO: set ARCHIVE_S3_ENDPOINT and
# ARCHIVE_S3_FORCE_PATH_STYLE=true).
ARCHIVE_S3_BUCKET=arnobot-saibya-data
ARCHIVE_S3_REGION=ap-south-1
ARCHIVE_S3_ENDPOINT=
# Leave both empty on EC2: credentials come from the instance's IAM role. Never commit real keys.
ARCHIVE_S3_ACCESS_KEY=
ARCHIVE_S3_SECRET_KEY=
ARCHIVE_S3_FORCE_PATH_STYLE=false
# Largest single file a robot may upload (MB)
ARCHIVE_UPLOAD_MAX_MB=100
# Open session with no upload for this long → "interrupted"
ARCHIVE_INTERRUPTED_AFTER_MINUTES=30
# Sensor chunk / camera segment length when session.json does not say (s)
ARCHIVE_CHUNK_SECONDS=60
ARCHIVE_VIDEO_SEGMENT_SECONDS=600
# Robot clock offset: chunk names like 20260924_134701 are robot local time
ROBOT_UTC_OFFSET=+05:30
# The ONLY folder the server writes temporary archive files to (MP4 exports in tmp/mp4). Safe to delete.
ARCHIVE_TEMP_DIR=./tmp
# MP4 export (download a camera as one .mp4). Needs ffmpeg + ffprobe on this host; built MP4s are
# deleted from ARCHIVE_TEMP_DIR after MP4_CACHE_HOURS.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MP4_CACHE_HOURS=24

# ── Secrets (server only) ───────────────────────────────────────────────────
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=1
# Previous keys, kept only to decrypt rows written before a key rotation: "1:<base64>,2:<base64>"
CREDENTIAL_ENCRYPTION_OLD_KEYS=
# HMAC pepper for session tokens and signed download links.
SESSION_SECRET=
SESSION_TTL_HOURS=12

# The first super-admin and demo robots are created by the storage seed (storage/.env, npm run db:seed).

# ── Services ────────────────────────────────────────────────────────────────
# One backend serves the admin API and robot/GCS ingestion (POST /api/v1/ingest).
API_PORT=4000
# 127.0.0.1 = this machine only. Use 0.0.0.0 when a GCS on the LAN / tunnel must reach ingestion.
API_HOST=127.0.0.1
# Ingestion limits (a reconnecting robot uploads backlog in batches).
INGEST_BODY_LIMIT_MB=20
INGEST_RATE_LIMIT_PER_MIN=600
ADMIN_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Cookie Secure flag. MUST be true in production (HTTPS).
COOKIE_SECURE=false
# Max upload size for documents / release packages (MB)
MAX_UPLOAD_MB=1024

# ── Optional MQTT transport for ingestion (empty = HTTPS only) ─────────────────
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

