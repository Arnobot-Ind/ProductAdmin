{
  "name": "@arnobot/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Arnobot PMS backend (Node.js + Fastify): admin REST API + Socket.IO push, and robot/GCS ingestion (HTTPS + optional MQTT).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node --env-file=../../.env dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@arnobot/db": "*",
    "@arnobot/message-schema": "*",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/lib-storage": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "cookie": "^1.0.2",
    "fastify": "^5.12.5",
    "mqtt": "^5.16.0",
    "pg": "^8.23.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
