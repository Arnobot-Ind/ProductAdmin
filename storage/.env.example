# Arnobot PMS storage: database setup. Copy to .env. NEVER commit .env.
# Run these scripts from any machine that can reach the database (your PC, or the EC2 server).

# Superuser / RDS master user: used ONLY by "npm run db:create" (and db:reset in development).
PG_ADMIN_URL=postgres://postgres:<postgres-password>@localhost:5432/postgres
# The app role + database the backend server connects to (same value as backend/.env DATABASE_URL).
DATABASE_URL=postgres://pms:change-me@localhost:5432/arnobot_pms

# First super-admin created by "npm run db:seed"
SEED_ADMIN_EMAIL=team@arnobot.in
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Arnobot Admin
# Also create demo robots (saibya01, saibya02, altius01, ductcleaning01) + write .sim-keys.json
SEED_DEMO_ROBOTS=true
# Where the simulator should send data (the backend server), written into .sim-keys.json
BACKEND_URL=http://localhost:4000
