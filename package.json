{
  "name": "arnobot-pms",
  "private": true,
  "version": "0.1.0",
  "description": "Arnobot PMS Product Admin: robot registry, ingestion, live state, telemetry, missions, events, documents and credentials",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "npm run migrate -w @arnobot/db",
    "db:status": "npm run status -w @arnobot/db",
    "db:seed": "npm run seed -w @arnobot/db",
    "dev": "turbo run dev --parallel --filter=@arnobot/backend --filter=@arnobot/frontend",
    "dev:backend": "npm run dev -w @arnobot/backend",
    "dev:frontend": "npm run dev -w @arnobot/frontend",
    "setup": "npm install && npm run build:packages && npm run db:create && npm run db:migrate && npm run db:seed",
    "db:create": "npm run create -w @arnobot/db",
    "db:timescale": "npm run timescale -w @arnobot/db",
    "db:reset": "npm run reset -w @arnobot/db -- --confirm && npm run db:create && npm run db:migrate && npm run db:seed",
    "start": "turbo run start --filter=@arnobot/backend --filter=@arnobot/frontend"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "turbo": "^2.11.4",
    "typescript": "~5.9.3"
  },
  "packageManager": "npm@10.9.2"
}
