{
  "name": "@arnobot/db",
  "version": "1.0.0",
  "private": true,
  "description": "PostgreSQL schema (numbered SQL migrations), migration runner, seed, and shared pg pool.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "create": "node --env-file=../../.env dist/cli/create-db.js",
    "migrate": "node --env-file=../../.env dist/cli/migrate.js up",
    "status": "node --env-file=../../.env dist/cli/migrate.js status",
    "seed": "node --env-file=../../.env dist/cli/seed.js",
    "timescale": "node --env-file=../../.env dist/cli/timescale.js",
    "test": "vitest run",
    "reset": "node --env-file=../../.env dist/cli/reset-db.js"
  },
  "dependencies": {
    "@arnobot/message-schema": "*",
    "@node-rs/argon2": "^2.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "vitest": "^5.0.2"
  }
}
